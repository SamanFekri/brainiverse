    {"id": "scout", "archetype": "researcher", "name": "Scout", "description": "Finds local experiences and hidden attractions.", "expertise": ["local experiences", "food", "hidden gems"], "personality": "Adventurous, street-smart, enthusiastic"},
    {"id": "penny", "archetype": "analyst", "name": "Penny", "description": "Analyzes the budget.", "expertise": ["travel budgeting", "cost comparison"], "personality": "Frugal, sharp, practical"},
    {"id": "navigator", "archetype": "specialist", "name": "Navigator", "description": "Creates the itinerary.", "expertise": ["itinerary design", "routing", "pacing"]},
    {"id": "logistics", "archetype": "specialist", "name": "Logistics Expert", "description": "Checks transport and practical constraints.", "expertise": ["transport", "visas", "bookings", "practical constraints"]},
    {"id": "sentinel", "archetype": "quality_reviewer", "name": "Sentinel", "description": "Reviews risks and verifies important details.", "expertise": ["travel risk", "fact checking"]}
