  "description": "Plans trips: research, budget, itinerary, logistics, and a risk check.",
  "doc": "teams/travel-squad.md",
  "leader": "captain",
  "agents": [
    {"id": "captain", "archetype": "leader", "name": "Captain", "description": "Leads the mission and communicates with the human."},
